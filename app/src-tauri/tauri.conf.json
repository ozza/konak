{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konak",
  "version": "0.1.0",
  "identifier": "io.github.ozza.konak",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Konak",
        "width": 520,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "resources/bin/caddy.exe": "bin/caddy.exe",
      "resources/bin/mdns-responder.exe": "bin/mdns-responder.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
